# Database: SQLite works out of the box; switch to Postgres via docker compose
DATABASE_URL=sqlite:///lead_engine.db
# DATABASE_URL=postgresql+psycopg://lead:lead@localhost:5432/lead_engine

# Local LLM (Ollama) used to extract company + signal from news items
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Where qualified leads go: local | odoo_api | odoo_email
LEAD_SINK=local

# odoo_api sink (needs external API access on your Odoo plan)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_API_KEY=

# odoo_email sink (CRM email alias, works without API access)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ODOO_LEAD_ALIAS=leads@yourcompany.odoo.com
