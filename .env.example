# Database: SQLite works out of the box; switch to Postgres via docker compose
DATABASE_URL=sqlite:///lead_engine.db
# DATABASE_URL=postgresql+psycopg://lead:lead@localhost:5432/lead_engine

# Local LLM (Ollama) used to extract company + signal from news items
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Where qualified leads go: local | odoo_api | odoo_email
LEAD_SINK=local

# odoo_api sink (needs external API access on your Odoo plan)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_API_KEY=

# Email account used by the sender, the inbox checker and the odoo_email sink.
# Hostinger: smtp.hostinger.com:465 (SSL) and imap.hostinger.com:993
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=sales@yourcompany.com
SMTP_PASSWORD=
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# Sender: dry_run (write .eml files) | test (everything to TEST_INBOX) | live
SEND_MODE=dry_run
TEST_INBOX=
DAILY_SEND_CAP=20

ODOO_LEAD_ALIAS=leads@yourcompany.odoo.com
